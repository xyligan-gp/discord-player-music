{
	"compilerOptions": {
		"lib": ["ES2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "ES2023",
		"outDir": "dist",
		"rootDir": ".",
		"declaration": true,
		"sourceMap": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"strict": true
	},
	"include": ["index.ts", "src/**/*"]
}
