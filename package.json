{
  "name": "discord-player-music",
  "version": "2.0.0",
  "description": "A powerful music module for your Discord bot with lots of features",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:docs": "node --require ./scripts/node-compat.cjs ./node_modules/@distube/docgen/src/index.js -s src/*.ts src/**/*.ts -o docs/index.json -c docs/index.yml -g -S 1 -j .jsconfig.json",
    "pub": "npm publish",
    "pub:dev": "npm publish --tag dev",
    "test": "vitest run",
    "lint": "eslint .",
    "check:jsdoc": "node scripts/check-jsdoc.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:jsdoc && npm test && npm run check:examples && npm run build:docs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "check:examples": "npm run build && tsc -p examples/tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyligan-gp/discord-player-music.git"
  },
  "author": "xyligan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xyligan-gp/discord-player-music/issues"
  },
  "homepage": "https://dpm.js.org",
  "keywords": [
    "discord",
    "discord-bot",
    "sidcord-music",
    "discord.js",
    "discord-player",
    "discord-player-music",
    "xyligan",
    "youtubei.js",
    "yt-dlp",
    "lrclib"
  ],
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.18.9",
    "@babel/preset-env": "^7.18.9",
    "@babel/preset-typescript": "^7.18.6",
    "@distube/docgen": "github:distubejs/docgen",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "discord.js": "^14.28.1",
    "eslint": "^10.15.0",
    "jsdoc-babel": "^0.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "discord.js": "^14.28.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
