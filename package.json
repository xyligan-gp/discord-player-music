{
	"name": "dpm-website",
	"version": "1.0.0",
	"private": true,
	"description": "Documentation website of discord-player-music (dpm.js.org)",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "tsx scripts/dev.ts",
		"dev:local": "tsx scripts/dev.ts --local",
		"fetch-docs": "tsx scripts/fetch-docs.ts",
		"prerender": "tsx scripts/prerender.ts",
		"build": "tsx scripts/fetch-docs.ts && tsx scripts/prerender.ts && next build",
		"preview": "npx --yes serve@14 out",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@shikijs/engine-javascript": "^4.6.0",
		"@shikijs/langs": "^4.6.0",
		"@shikijs/rehype": "^4.6.0",
		"@shikijs/themes": "^4.6.0",
		"cmdk": "^1.1.1",
		"geist": "^1.9.2",
		"lucide-react": "^1.73.0",
		"next": "^16.4.6",
		"next-themes": "^0.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rehype-raw": "^7.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.6.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.5",
		"@types/node": "^22.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^5.9.0"
	}
}
